{
    "resource": "resource_test.workshop",
    "operation": "configure",
    "label": "Configure the workshop",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Configure the workshop",
        "x-surface": {
            "contract": 4,
            "version": 1,
            "rules": [
                0
            ]
        },
        "type": "object",
        "properties": {
            "closed": {
                "title": "Closed",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": false
            },
            "benches": {
                "title": "Benches",
                "allOf": [
                    {
                        "$ref": "#/$defs/resource_test.workshop.benches"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "press": {
                                "allOf": [
                                    {
                                        "$ref": "#/$defs/resource_test.workshop.bench"
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "enabled": {
                                                "readOnly": true
                                            },
                                            "hours": {
                                                "readOnly": true
                                            }
                                        }
                                    }
                                ],
                                "readOnly": true
                            }
                        }
                    }
                ]
            },
            "lights": {
                "title": "Lights",
                "description": "Which benches have their lamp on.",
                "allOf": [
                    {
                        "$ref": "#/$defs/resource_test.workshop.lights"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "press": {
                                "default": false,
                                "readOnly": true
                            }
                        }
                    }
                ],
                "x-surface": {
                    "dependsOn": [
                        "closed"
                    ]
                }
            },
            "codes": {
                "title": "Bench codes",
                "allOf": [
                    {
                        "$ref": "#/$defs/resource_test.workshop.codes"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "press": {
                                "readOnly": true
                            }
                        }
                    }
                ]
            }
        },
        "additionalProperties": false,
        "allOf": [
            {
                "if": {
                    "properties": {
                        "closed": {
                            "const": true
                        }
                    },
                    "required": [
                        "closed"
                    ]
                },
                "then": {
                    "properties": {
                        "lights": false
                    }
                }
            }
        ],
        "$defs": {
            "resource_test.workshop.bench": {
                "title": "resource_test.workshop.bench",
                "type": "object",
                "properties": {
                    "enabled": {
                        "title": "In use",
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "default": true
                    },
                    "hours": {
                        "title": "Hours a day",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 12,
                        "default": 1,
                        "x-surface": {
                            "dependsOn": [
                                "enabled"
                            ]
                        }
                    }
                },
                "additionalProperties": false,
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "enabled": {
                                    "const": false
                                }
                            },
                            "required": [
                                "enabled"
                            ]
                        },
                        "then": {
                            "properties": {
                                "hours": false
                            }
                        }
                    }
                ],
                "x-surface": {
                    "rules": [
                        0
                    ]
                }
            },
            "resource_test.workshop.benches": {
                "title": "resource_test.workshop.benches",
                "type": "object",
                "properties": {
                    "lathe": {
                        "title": "Lathe",
                        "$ref": "#/$defs/resource_test.workshop.bench"
                    },
                    "press": {
                        "title": "Drill press",
                        "$ref": "#/$defs/resource_test.workshop.bench"
                    },
                    "saw": {
                        "title": "Band saw",
                        "$ref": "#/$defs/resource_test.workshop.bench"
                    }
                },
                "additionalProperties": false
            },
            "resource_test.workshop.lights": {
                "title": "resource_test.workshop.lights",
                "type": "object",
                "properties": {
                    "lathe": {
                        "title": "Lathe",
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "default": false
                    },
                    "press": {
                        "title": "Drill press",
                        "type": [
                            "boolean",
                            "null"
                        ]
                    },
                    "saw": {
                        "title": "Band saw",
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "default": false
                    }
                },
                "additionalProperties": false
            },
            "resource_test.workshop.codes": {
                "title": "resource_test.workshop.codes",
                "type": "object",
                "properties": {
                    "lathe": {
                        "$ref": "#/$defs/resource_test.sku",
                        "title": "Lathe",
                        "x-surface": {
                            "patternMessage": "A stock code is two capitals and digits, such as AB12."
                        }
                    },
                    "press": {
                        "$ref": "#/$defs/resource_test.sku",
                        "title": "Drill press",
                        "x-surface": {
                            "patternMessage": "A stock code is two capitals and digits, such as AB12."
                        }
                    },
                    "saw": {
                        "$ref": "#/$defs/resource_test.sku",
                        "title": "Band saw",
                        "x-surface": {
                            "patternMessage": "A stock code is two capitals and digits, such as AB12."
                        }
                    }
                },
                "additionalProperties": false
            },
            "resource_test.sku": {
                "title": "resource_test.sku",
                "description": "Two capitals and digits, as printed on the shelf.",
                "type": [
                    "string",
                    "null"
                ],
                "pattern": "^[A-Z]{2}\\d+$",
                "maxLength": 12,
                "examples": [
                    "AB12"
                ],
                "x-surface": {
                    "patternMessage": "A stock code is two capitals and digits, such as AB12."
                }
            }
        }
    }
}
