{
    "resource": "first.newsletter",
    "module": "surface_examples_first",
    "contract": 4,
    "documents": [
        {
            "resource": "first.newsletter",
            "operation": "configure",
            "label": "Configure the newsletter",
            "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Configure the newsletter",
                "description": "Sets who the newsletter is sent from, how often it goes out and how many recipients one send reaches.",
                "x-surface": {
                    "contract": 4,
                    "operation": {
                        "id": "configure",
                        "label": "Configure the newsletter",
                        "description": "Sets who the newsletter is sent from, how often it goes out and how many recipients one send reaches.",
                        "kind": "update",
                        "creates": false,
                        "destructive": false,
                        "idempotent": true
                    },
                    "version": 1
                },
                "type": "object",
                "properties": {
                    "sender_name": {
                        "title": "Sender name",
                        "type": "string",
                        "maxLength": 64
                    },
                    "sender_email": {
                        "title": "Sender email",
                        "type": "string",
                        "format": "idn-email"
                    },
                    "frequency": {
                        "title": "Frequency",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "weekly",
                                "title": "Weekly"
                            },
                            {
                                "const": "monthly",
                                "title": "Monthly"
                            }
                        ],
                        "default": "weekly"
                    },
                    "max_recipients": {
                        "title": "Maximum recipients per send",
                        "description": "Larger lists are sent in batches of this size.",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 10000,
                        "default": 500
                    }
                },
                "additionalProperties": false,
                "required": [
                    "sender_name",
                    "sender_email",
                    "frequency"
                ]
            }
        }
    ]
}
