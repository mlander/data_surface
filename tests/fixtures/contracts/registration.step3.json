{
    "surface": "registration.step3",
    "documents": [
        {
            "surface": "registration.step3",
            "situation": "configure",
            "label": "Configure registration",
            "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Configure registration",
                "x-surface": {
                    "operation": {
                        "id": "configure",
                        "label": "Configure registration",
                        "creates": false,
                        "readOnly": false,
                        "destructive": false,
                        "idempotent": true
                    },
                    "version": 1
                },
                "type": "object",
                "properties": {
                    "title": {
                        "title": "Public event title",
                        "type": "string",
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "open": {
                        "title": "Registration open",
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "default": true,
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "venue": {
                        "title": "Venue",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "riverside",
                                "title": "Riverside Hall"
                            },
                            {
                                "const": "library",
                                "title": "Old Library"
                            },
                            {
                                "const": "harbour",
                                "title": "Harbour Centre"
                            }
                        ],
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "room": {
                        "title": "Room",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "riverside_main",
                                "title": "Main hall"
                            },
                            {
                                "const": "riverside_east",
                                "title": "East room"
                            },
                            {
                                "const": "library_reading",
                                "title": "Reading room"
                            },
                            {
                                "const": "library_garden",
                                "title": "Garden room"
                            },
                            {
                                "const": "harbour_auditorium",
                                "title": "Auditorium"
                            },
                            {
                                "const": "harbour_deck",
                                "title": "Upper deck"
                            }
                        ],
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "venue"
                            ],
                            "enumerated": true,
                            "runtime": true
                        }
                    },
                    "capacity": {
                        "title": "Capacity",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 1000,
                        "default": 50,
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "room",
                                "third_party_settings.data_surface_examples_compliance.licence"
                            ],
                            "enumerated": true,
                            "declared": true
                        }
                    },
                    "pricing": {
                        "title": "Pricing",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "free",
                                "title": "free"
                            },
                            {
                                "const": "paid",
                                "title": "paid"
                            }
                        ],
                        "default": "free",
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "ticket": {
                        "title": "Ticket",
                        "type": [
                            "object",
                            "null"
                        ],
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "pricing"
                            ],
                            "by": "pricing",
                            "variants": [
                                "free",
                                "paid"
                            ]
                        }
                    },
                    "contact": {
                        "title": "Contact",
                        "$ref": "#/$defs/registration.contact",
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "third_party_settings": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "data_surface_examples_compliance": {
                                "title": "Compliance",
                                "$ref": "#/$defs/registration.compliance",
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": [],
                                    "after": "capacity",
                                    "reads": {
                                        "capacity": "capacity"
                                    }
                                }
                            }
                        },
                        "additionalProperties": false,
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "capacity"
                            ],
                            "group": true,
                            "dynamic": true
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "title",
                    "venue",
                    "room",
                    "pricing"
                ],
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "venue": {
                                    "const": "riverside"
                                }
                            },
                            "required": [
                                "venue"
                            ]
                        },
                        "then": {
                            "properties": {
                                "room": {
                                    "oneOf": [
                                        {
                                            "const": "riverside_main",
                                            "title": "Main hall"
                                        },
                                        {
                                            "const": "riverside_east",
                                            "title": "East room"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "venue": {
                                    "const": "library"
                                }
                            },
                            "required": [
                                "venue"
                            ]
                        },
                        "then": {
                            "properties": {
                                "room": {
                                    "oneOf": [
                                        {
                                            "const": "library_reading",
                                            "title": "Reading room"
                                        },
                                        {
                                            "const": "library_garden",
                                            "title": "Garden room"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "venue": {
                                    "const": "harbour"
                                }
                            },
                            "required": [
                                "venue"
                            ]
                        },
                        "then": {
                            "properties": {
                                "room": {
                                    "oneOf": [
                                        {
                                            "const": "harbour_auditorium",
                                            "title": "Auditorium"
                                        },
                                        {
                                            "const": "harbour_deck",
                                            "title": "Upper deck"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "riverside_main"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 400 for the Main hall.",
                                    "maximum": 400
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "riverside_east"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 120 for the East room.",
                                    "maximum": 120
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "library_reading"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 60 for the Reading room.",
                                    "maximum": 60
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "library_garden"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 30 for the Garden room.",
                                    "maximum": 30
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "harbour_auditorium"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 800 for the Auditorium.",
                                    "maximum": 800
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "room": {
                                    "const": "harbour_deck"
                                }
                            },
                            "required": [
                                "room"
                            ]
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 150 for the Upper deck.",
                                    "maximum": 150
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "third_party_settings": {
                                    "properties": {
                                        "data_surface_examples_compliance": {
                                            "properties": {
                                                "licence": {
                                                    "type": "null"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "capacity": {
                                    "description": "Up to 100 without an event licence.",
                                    "maximum": 100
                                }
                            }
                        },
                        "x-surface": {
                            "declared": true
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "pricing": {
                                    "const": "free"
                                }
                            },
                            "required": [
                                "pricing"
                            ]
                        },
                        "then": {
                            "properties": {
                                "ticket": {
                                    "title": "Ticket",
                                    "$ref": "#/$defs/registration.step3.ticket.free",
                                    "x-surface": {
                                        "locked": false,
                                        "dependsOn": [],
                                        "variant": "free"
                                    }
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "pricing": {
                                    "const": "paid"
                                }
                            },
                            "required": [
                                "pricing"
                            ]
                        },
                        "then": {
                            "properties": {
                                "ticket": {
                                    "title": "Ticket",
                                    "$ref": "#/$defs/registration.step3.ticket.paid",
                                    "x-surface": {
                                        "locked": false,
                                        "dependsOn": [],
                                        "variant": "paid"
                                    }
                                }
                            }
                        }
                    }
                ],
                "$defs": {
                    "registration.step3.ticket.free": {
                        "type": "object",
                        "properties": {
                            "note": {
                                "title": "Note",
                                "description": "Shown beside the register button, for example \"Donations welcome\".",
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": []
                                }
                            }
                        },
                        "additionalProperties": false
                    },
                    "registration.step3.ticket.paid": {
                        "type": "object",
                        "properties": {
                            "price": {
                                "title": "Price",
                                "type": "number",
                                "minimum": 0.01,
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": []
                                }
                            },
                            "currency": {
                                "title": "Currency",
                                "type": "string",
                                "oneOf": [
                                    {
                                        "const": "EUR",
                                        "title": "EUR"
                                    },
                                    {
                                        "const": "GBP",
                                        "title": "GBP"
                                    },
                                    {
                                        "const": "USD",
                                        "title": "USD"
                                    }
                                ],
                                "default": "EUR",
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": []
                                }
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "price",
                            "currency"
                        ]
                    },
                    "registration.contact": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "title": "Email",
                                "type": "string",
                                "format": "email",
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": []
                                }
                            },
                            "phone": {
                                "title": "Phone",
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": []
                                }
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "email"
                        ]
                    },
                    "registration.compliance": {
                        "type": "object",
                        "properties": {
                            "licence": {
                                "$ref": "#/$defs/event.licence",
                                "title": "Event licence",
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": [],
                                    "patternMessage": "A licence number is four digits, such as 2048."
                                }
                            },
                            "stewards": {
                                "title": "Stewards",
                                "type": "integer",
                                "default": 1,
                                "x-surface": {
                                    "locked": false,
                                    "dependsOn": [
                                        "capacity"
                                    ]
                                }
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "stewards"
                        ],
                        "x-surface": {
                            "ports": {
                                "capacity": {
                                    "type": "integer",
                                    "required": true
                                }
                            }
                        }
                    },
                    "event.licence": {
                        "title": "Event licence",
                        "description": "The four digits after EV- on the licence, such as 2048. Required to host more than 100 people.",
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^\\d{4}$",
                        "examples": [
                            "2048"
                        ],
                        "x-surface": {
                            "patternMessage": "A licence number is four digits, such as 2048."
                        }
                    }
                }
            }
        }
    ]
}
