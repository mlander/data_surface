{
    "resource": "event.bulletin",
    "module": "data_surface_examples",
    "contract": 3,
    "documents": [
        {
            "resource": "event.bulletin",
            "operation": "configure",
            "label": "Configure the bulletin",
            "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Configure the bulletin",
                "description": "Sets how often the event bulletin goes out, the day it is sent and how many items an issue holds.",
                "x-surface": {
                    "contract": 3,
                    "operation": {
                        "id": "configure",
                        "label": "Configure the bulletin",
                        "description": "Sets how often the event bulletin goes out, the day it is sent and how many items an issue holds.",
                        "kind": "update",
                        "creates": false,
                        "destructive": false,
                        "idempotent": true
                    },
                    "version": 1,
                    "rules": [
                        0,
                        1,
                        2
                    ]
                },
                "type": "object",
                "properties": {
                    "frequency": {
                        "title": "Frequency",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "weekly",
                                "title": "Weekly"
                            },
                            {
                                "const": "monthly",
                                "title": "Monthly"
                            }
                        ],
                        "default": "weekly",
                        "x-surface": {
                            "locked": false,
                            "dependsOn": []
                        }
                    },
                    "send_day": {
                        "title": "Send day",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "monday",
                                "title": "Monday"
                            },
                            {
                                "const": "wednesday",
                                "title": "Wednesday"
                            },
                            {
                                "const": "friday",
                                "title": "Friday"
                            }
                        ],
                        "default": "monday",
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "frequency"
                            ],
                            "declared": true
                        }
                    },
                    "items": {
                        "title": "Items per issue",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 20,
                        "default": 5,
                        "x-surface": {
                            "locked": false,
                            "dependsOn": [
                                "frequency"
                            ],
                            "declared": true
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "frequency"
                ],
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "frequency": {
                                    "const": "monthly"
                                }
                            },
                            "required": [
                                "frequency"
                            ]
                        },
                        "then": {
                            "properties": {
                                "send_day": false
                            }
                        }
                    },
                    {
                        "if": {
                            "not": {
                                "properties": {
                                    "frequency": {
                                        "const": "monthly"
                                    }
                                },
                                "required": [
                                    "frequency"
                                ]
                            }
                        },
                        "then": {
                            "required": [
                                "send_day"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "frequency": {
                                    "const": "weekly"
                                }
                            },
                            "required": [
                                "frequency"
                            ]
                        },
                        "then": {
                            "properties": {
                                "items": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "description": "Up to 5 in a weekly issue.",
                                    "maximum": 5
                                }
                            }
                        }
                    }
                ]
            }
        }
    ]
}
