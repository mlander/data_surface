{
    "resource": "registration.step3",
    "operation": "configure",
    "label": "Configure registration (step 3)",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://localhost/surface-api/registration.step3",
        "title": "Configure registration (step 3)",
        "description": "Sets the event registration: its title, whether it is open, the venue and room, the capacity, the pricing with its ticket, and the contact.",
        "x-surface": {
            "contract": 4,
            "operation": {
                "id": "configure",
                "label": "Configure registration (step 3)",
                "description": "Sets the event registration: its title, whether it is open, the venue and room, the capacity, the pricing with its ticket, and the contact.",
                "kind": "update",
                "creates": false,
                "destructive": false,
                "idempotent": true
            },
            "version": 1
        },
        "type": "object",
        "properties": {
            "title": {
                "title": "Public event title",
                "type": "string",
                "x-surface": {
                    "widget": "text"
                }
            },
            "open": {
                "title": "Registration open",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": true,
                "x-surface": {
                    "widget": "checkbox"
                }
            },
            "venue": {
                "title": "Venue",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside",
                        "title": "Riverside Hall"
                    },
                    {
                        "const": "library",
                        "title": "Old Library"
                    },
                    {
                        "const": "harbour",
                        "title": "Harbour Centre"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "room": {
                "title": "Room",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside_main",
                        "title": "Main hall"
                    },
                    {
                        "const": "riverside_east",
                        "title": "East room"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "dependsOn": [
                        "venue"
                    ],
                    "refined": true,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    },
                    "live": true
                }
            },
            "capacity": {
                "title": "Capacity",
                "description": "Up to 100 without an event license.",
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "maximum": 100,
                "default": 50,
                "x-surface": {
                    "widget": "number",
                    "dependsOn": [
                        "room",
                        "third_party_settings.surface_examples_compliance.license"
                    ],
                    "refined": true
                }
            },
            "pricing": {
                "title": "Pricing",
                "type": "string",
                "oneOf": [
                    {
                        "const": "free",
                        "title": "Free"
                    },
                    {
                        "const": "paid",
                        "title": "Paid"
                    }
                ],
                "default": "free",
                "x-surface": {
                    "widget": "select",
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "ticket": {
                "title": "Ticket",
                "anyOf": [
                    {
                        "$ref": "#/$defs/registration.step3.ticket.free"
                    },
                    {
                        "$ref": "#/$defs/registration.step3.ticket.paid"
                    },
                    {
                        "type": "null"
                    }
                ],
                "x-surface": {
                    "widget": "variants",
                    "dependsOn": [
                        "pricing"
                    ],
                    "refined": true,
                    "by": "pricing",
                    "variants": {
                        "free": "#/$defs/registration.step3.ticket.free",
                        "paid": "#/$defs/registration.step3.ticket.paid"
                    },
                    "chosen": "free"
                }
            },
            "contact": {
                "title": "Contact",
                "$ref": "#/$defs/registration.contact",
                "x-surface": {
                    "widget": "fieldset"
                }
            },
            "third_party_settings": {
                "type": [
                    "object",
                    "null"
                ],
                "properties": {
                    "surface_examples_compliance": {
                        "title": "Compliance",
                        "allOf": [
                            {
                                "$ref": "#/$defs/registration.compliance"
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "stewards": {
                                        "type": "integer",
                                        "description": "At least 1 steward for 50 attendees.",
                                        "minimum": 1
                                    }
                                }
                            }
                        ],
                        "x-surface": {
                            "widget": "fieldset",
                            "refined": true,
                            "after": "capacity",
                            "reads": {
                                "capacity": "capacity"
                            },
                            "within": {
                                "/allOf/1/properties/stewards": {
                                    "widget": "number",
                                    "dependsOn": [
                                        "capacity"
                                    ],
                                    "refined": true
                                }
                            }
                        }
                    }
                },
                "additionalProperties": false,
                "x-surface": {
                    "widget": "fieldset",
                    "dependsOn": [
                        "capacity"
                    ],
                    "refined": true,
                    "group": true
                }
            }
        },
        "additionalProperties": false,
        "required": [
            "title",
            "venue",
            "room",
            "pricing"
        ],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "pricing": {
                            "const": "free"
                        }
                    },
                    "required": [
                        "pricing"
                    ]
                },
                "then": {
                    "properties": {
                        "ticket": {
                            "title": "Ticket",
                            "$ref": "#/$defs/registration.step3.ticket.free"
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "pricing": {
                            "const": "paid"
                        }
                    },
                    "required": [
                        "pricing"
                    ]
                },
                "then": {
                    "properties": {
                        "ticket": {
                            "title": "Ticket",
                            "$ref": "#/$defs/registration.step3.ticket.paid"
                        }
                    }
                }
            }
        ],
        "$defs": {
            "registration.step3.ticket.free": {
                "title": "registration.step3.ticket.free",
                "type": "object",
                "properties": {
                    "note": {
                        "title": "Note",
                        "description": "Shown beside the register button, for example \"Donations welcome\".",
                        "type": [
                            "string",
                            "null"
                        ],
                        "x-surface": {
                            "widget": "text"
                        }
                    }
                },
                "additionalProperties": false
            },
            "registration.step3.ticket.paid": {
                "title": "registration.step3.ticket.paid",
                "type": "object",
                "properties": {
                    "price": {
                        "title": "Price",
                        "type": "number",
                        "minimum": 0.01,
                        "x-surface": {
                            "widget": "number"
                        }
                    },
                    "currency": {
                        "title": "Currency",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "EUR",
                                "title": "EUR"
                            },
                            {
                                "const": "GBP",
                                "title": "GBP"
                            },
                            {
                                "const": "USD",
                                "title": "USD"
                            }
                        ],
                        "default": "EUR",
                        "x-surface": {
                            "widget": "select",
                            "emptyOption": {
                                "show": false,
                                "label": "- Select -"
                            }
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "price",
                    "currency"
                ]
            },
            "registration.contact": {
                "title": "registration.contact",
                "type": "object",
                "properties": {
                    "email": {
                        "title": "Email",
                        "type": "string",
                        "format": "idn-email",
                        "x-surface": {
                            "widget": "email"
                        }
                    },
                    "phone": {
                        "title": "Phone",
                        "type": [
                            "string",
                            "null"
                        ],
                        "x-surface": {
                            "widget": "text"
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "email"
                ]
            },
            "registration.compliance": {
                "title": "registration.compliance",
                "type": "object",
                "properties": {
                    "license": {
                        "$ref": "#/$defs/event.license",
                        "title": "Event license",
                        "x-surface": {
                            "widget": "text",
                            "patternMessage": "A license number is four digits, such as 2048."
                        }
                    },
                    "stewards": {
                        "title": "Stewards",
                        "type": "integer",
                        "default": 1,
                        "x-surface": {
                            "widget": "number",
                            "dependsOn": [
                                "capacity"
                            ]
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "stewards"
                ],
                "x-surface": {
                    "ports": {
                        "capacity": {
                            "type": "integer",
                            "required": true
                        }
                    }
                }
            },
            "event.license": {
                "title": "event.license",
                "description": "The four digits after EV- on the license, such as 2048. Required to host more than 100 people.",
                "type": [
                    "string",
                    "null"
                ],
                "pattern": "^\\d{4}$",
                "examples": [
                    "2048"
                ],
                "x-surface": {
                    "patternMessage": "A license number is four digits, such as 2048."
                }
            }
        }
    },
    "values": {
        "title": "Spring meetup",
        "open": true,
        "venue": "riverside",
        "room": "riverside_main",
        "capacity": 50,
        "pricing": "free",
        "ticket": {
            "note": ""
        },
        "contact": {
            "email": "events@example.com",
            "phone": ""
        },
        "third_party_settings": {
            "surface_examples_compliance": {
                "license": null,
                "stewards": 1
            }
        }
    },
    "stale": [],
    "notes": []
}
