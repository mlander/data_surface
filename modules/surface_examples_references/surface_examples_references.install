<?php

/**
 * @file
 * Install and uninstall functions for the references example.
 */

declare(strict_types=1);

use Drupal\surface_examples_references\Sponsorship;

/**
 * Implements hook_uninstall().
 *
 * Deletes the nodes the module wrote when it was installed.
 */
function surface_examples_references_uninstall(bool $is_syncing): void {
  \Drupal::classResolver(Sponsorship::class)->deleteNodes();
}
