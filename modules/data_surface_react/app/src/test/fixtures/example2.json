{
    "resource": "registration.step2",
    "operation": "configure",
    "label": "Configure registration (step 2)",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://localhost/surface-api/registration.step2/configure",
        "title": "Configure registration (step 2)",
        "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
        "x-surface": {
            "contract": 2,
            "operation": {
                "id": "configure",
                "label": "Configure registration (step 2)",
                "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
                "kind": "update",
                "creates": false,
                "destructive": false,
                "idempotent": true
            },
            "version": 1
        },
        "type": "object",
        "properties": {
            "title": {
                "title": "Event title",
                "type": "string",
                "x-surface": {
                    "widget": "text",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "open": {
                "title": "Registration open",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": true,
                "x-surface": {
                    "widget": "checkbox",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "venue": {
                "title": "Venue",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside",
                        "title": "Riverside Hall"
                    },
                    {
                        "const": "library",
                        "title": "Old Library"
                    },
                    {
                        "const": "harbour",
                        "title": "Harbour Centre"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "room": {
                "title": "Room",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside_main",
                        "title": "Main hall"
                    },
                    {
                        "const": "riverside_east",
                        "title": "East room"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [
                        "venue"
                    ],
                    "refined": true,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "capacity": {
                "title": "Capacity",
                "description": "Up to 400 for the Main hall.",
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "maximum": 400,
                "default": 50,
                "x-surface": {
                    "widget": "number",
                    "locked": false,
                    "dependsOn": [
                        "room"
                    ],
                    "refined": true,
                    "stale": false
                }
            }
        },
        "additionalProperties": false,
        "required": [
            "title",
            "venue",
            "room"
        ]
    },
    "values": {
        "title": "Spring meetup",
        "open": true,
        "venue": "riverside",
        "room": "riverside_main",
        "capacity": 50
    },
    "stale": []
}
