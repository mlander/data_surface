{
    "resource": "registration.step2",
    "operation": "configure",
    "label": "Configure registration (step 2)",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://localhost/surface-api/registration.step2/configure",
        "title": "Configure registration (step 2)",
        "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
        "x-surface": {
            "contract": 2,
            "operation": {
                "id": "configure",
                "label": "Configure registration (step 2)",
                "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
                "kind": "update",
                "creates": false,
                "destructive": false,
                "idempotent": true
            },
            "version": 1
        },
        "type": "object",
        "properties": {
            "title": {
                "title": "Event title",
                "type": "string",
                "x-surface": {
                    "widget": "text",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "open": {
                "title": "Registration open",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": true,
                "x-surface": {
                    "widget": "checkbox",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "venue": {
                "title": "Venue",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside",
                        "title": "Riverside Hall"
                    },
                    {
                        "const": "library",
                        "title": "Old Library"
                    },
                    {
                        "const": "harbour",
                        "title": "Harbour Centre"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "room": {
                "title": "Room",
                "type": "string",
                "oneOf": [
                    {
                        "const": "library_reading",
                        "title": "Reading room"
                    },
                    {
                        "const": "library_garden",
                        "title": "Garden room"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [
                        "venue"
                    ],
                    "refined": true,
                    "stale": true,
                    "emptyOption": {
                        "show": true,
                        "label": "- Select -"
                    }
                }
            },
            "capacity": {
                "title": "Capacity",
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "default": 50,
                "x-surface": {
                    "widget": "number",
                    "locked": false,
                    "dependsOn": [
                        "room"
                    ],
                    "refined": false,
                    "stale": false,
                    "enumerated": true
                }
            }
        },
        "additionalProperties": false,
        "required": [
            "title",
            "venue",
            "room"
        ],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "room": {
                            "const": "library_reading"
                        }
                    },
                    "required": [
                        "room"
                    ]
                },
                "then": {
                    "properties": {
                        "capacity": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Up to 60 for the Reading room.",
                            "maximum": 60
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "room": {
                            "const": "library_garden"
                        }
                    },
                    "required": [
                        "room"
                    ]
                },
                "then": {
                    "properties": {
                        "capacity": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Up to 30 for the Garden room.",
                            "maximum": 30
                        }
                    }
                }
            }
        ]
    },
    "values": {
        "title": "Spring meetup",
        "open": true,
        "venue": "library",
        "room": null,
        "capacity": 50
    },
    "stale": [
        "room"
    ],
    "discarded": [
        "room",
        "capacity"
    ]
}
