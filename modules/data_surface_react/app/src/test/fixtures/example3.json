{
    "surface": "registration.step3",
    "situation": "configure",
    "label": "Configure registration",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Configure registration",
        "type": "object",
        "properties": {
            "title": {
                "title": "Public event title",
                "type": "string",
                "x-surface": {
                    "widget": "text",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "open": {
                "title": "Registration open",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": true,
                "x-surface": {
                    "widget": "checkbox",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "venue": {
                "title": "Venue",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside",
                        "title": "Riverside Hall"
                    },
                    {
                        "const": "library",
                        "title": "Old Library"
                    },
                    {
                        "const": "harbour",
                        "title": "Harbour Centre"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "room": {
                "title": "Room",
                "type": "string",
                "oneOf": [
                    {
                        "const": "riverside_main",
                        "title": "Main hall"
                    },
                    {
                        "const": "riverside_east",
                        "title": "East room"
                    }
                ],
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [
                        "venue"
                    ],
                    "refined": true,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "capacity": {
                "title": "Capacity",
                "description": "Up to 100 without an event licence. With one, up to 400.",
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "maximum": 100,
                "default": 50,
                "x-surface": {
                    "widget": "number",
                    "locked": false,
                    "dependsOn": [
                        "room",
                        "third_party_settings.data_surface_examples_compliance.licence"
                    ],
                    "refined": true,
                    "stale": false
                }
            },
            "pricing": {
                "title": "Pricing",
                "type": "string",
                "oneOf": [
                    {
                        "const": "free",
                        "title": "free"
                    },
                    {
                        "const": "paid",
                        "title": "paid"
                    }
                ],
                "default": "free",
                "x-surface": {
                    "widget": "select",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false,
                    "emptyOption": {
                        "show": false,
                        "label": "- Select -"
                    }
                }
            },
            "ticket": {
                "title": "Ticket",
                "type": [
                    "object",
                    "null"
                ],
                "x-surface": {
                    "widget": "slot",
                    "locked": false,
                    "dependsOn": [
                        "pricing"
                    ],
                    "refined": true,
                    "stale": false,
                    "by": "pricing",
                    "variants": [
                        "free",
                        "paid"
                    ],
                    "chosen": "free"
                }
            },
            "contact": {
                "title": "Contact",
                "type": "object",
                "properties": {
                    "email": {
                        "title": "Email",
                        "type": "string",
                        "format": "email",
                        "x-surface": {
                            "widget": "email",
                            "locked": false,
                            "dependsOn": [],
                            "refined": false,
                            "stale": false
                        }
                    },
                    "phone": {
                        "title": "Phone",
                        "type": [
                            "string",
                            "null"
                        ],
                        "x-surface": {
                            "widget": "text",
                            "locked": false,
                            "dependsOn": [],
                            "refined": false,
                            "stale": false
                        }
                    }
                },
                "additionalProperties": false,
                "required": [
                    "email"
                ],
                "x-surface": {
                    "widget": "fieldset",
                    "locked": false,
                    "dependsOn": [],
                    "refined": false,
                    "stale": false
                }
            },
            "third_party_settings": {
                "type": [
                    "object",
                    "null"
                ],
                "properties": {
                    "data_surface_examples_compliance": {
                        "title": "Compliance",
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "licence": {
                                "title": "Event licence",
                                "description": "The four digits after EV- on the licence, such as 2048. Required to host more than 100 people.",
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "pattern": "^\\d{4}$",
                                "examples": [
                                    "2048"
                                ],
                                "x-surface": {
                                    "widget": "text",
                                    "locked": false,
                                    "dependsOn": [],
                                    "refined": false,
                                    "stale": false,
                                    "patternMessage": "A licence number is four digits, such as 2048."
                                }
                            },
                            "stewards": {
                                "title": "Stewards",
                                "description": "At least 1 steward for 50 attendees.",
                                "type": "integer",
                                "minimum": 1,
                                "default": 1,
                                "x-surface": {
                                    "widget": "number",
                                    "locked": false,
                                    "dependsOn": [],
                                    "refined": true,
                                    "stale": false
                                }
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "stewards"
                        ],
                        "x-surface": {
                            "widget": "fieldset",
                            "locked": false,
                            "dependsOn": [],
                            "refined": true,
                            "stale": false
                        }
                    }
                },
                "additionalProperties": false,
                "x-surface": {
                    "widget": "fieldset",
                    "locked": false,
                    "dependsOn": [
                        "capacity"
                    ],
                    "refined": true,
                    "stale": false,
                    "group": true
                }
            }
        },
        "additionalProperties": false,
        "required": [
            "title",
            "venue",
            "room",
            "pricing"
        ],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "pricing": {
                            "const": "free"
                        }
                    },
                    "required": [
                        "pricing"
                    ]
                },
                "then": {
                    "properties": {
                        "ticket": {
                            "title": "Ticket",
                            "type": "object",
                            "properties": {
                                "note": {
                                    "title": "Note",
                                    "description": "Shown beside the register button, for example \"Donations welcome\".",
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "x-surface": {
                                        "widget": "text",
                                        "locked": false,
                                        "dependsOn": [],
                                        "refined": false,
                                        "stale": false
                                    }
                                }
                            },
                            "additionalProperties": false,
                            "x-surface": {
                                "widget": "fieldset",
                                "locked": false,
                                "dependsOn": [],
                                "refined": false,
                                "stale": false,
                                "variant": "free"
                            }
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "pricing": {
                            "const": "paid"
                        }
                    },
                    "required": [
                        "pricing"
                    ]
                },
                "then": {
                    "properties": {
                        "ticket": {
                            "title": "Ticket",
                            "type": "object",
                            "properties": {
                                "price": {
                                    "title": "Price",
                                    "type": "number",
                                    "minimum": 0.01,
                                    "x-surface": {
                                        "widget": "number",
                                        "locked": false,
                                        "dependsOn": [],
                                        "refined": false,
                                        "stale": false
                                    }
                                },
                                "currency": {
                                    "title": "Currency",
                                    "type": "string",
                                    "oneOf": [
                                        {
                                            "const": "EUR",
                                            "title": "EUR"
                                        },
                                        {
                                            "const": "GBP",
                                            "title": "GBP"
                                        },
                                        {
                                            "const": "USD",
                                            "title": "USD"
                                        }
                                    ],
                                    "default": "EUR",
                                    "x-surface": {
                                        "widget": "select",
                                        "locked": false,
                                        "dependsOn": [],
                                        "refined": false,
                                        "stale": false,
                                        "emptyOption": {
                                            "show": false,
                                            "label": "- Select -"
                                        }
                                    }
                                }
                            },
                            "additionalProperties": false,
                            "required": [
                                "price",
                                "currency"
                            ],
                            "x-surface": {
                                "widget": "fieldset",
                                "locked": false,
                                "dependsOn": [],
                                "refined": false,
                                "stale": false,
                                "variant": "paid"
                            }
                        }
                    }
                }
            }
        ]
    },
    "values": {
        "title": "Spring meetup",
        "open": true,
        "venue": "riverside",
        "room": "riverside_main",
        "capacity": 50,
        "pricing": "free",
        "ticket": {
            "note": ""
        },
        "contact": {
            "email": "events@example.com",
            "phone": ""
        },
        "third_party_settings": {
            "data_surface_examples_compliance": {
                "licence": null,
                "stewards": 1
            }
        }
    },
    "stale": []
}
