# Configuration file for PHPStan static code checking, see https://phpstan.org .
# Run it from the Drupal root:
#   vendor/bin/phpstan analyse -c web/modules/custom/data_surface/phpstan.neon
# A static #[RefinesInput] method is a pure function of the keys it
# watches: one that calls \Drupal:: is flagged before it ever runs
# (tests/src/PHPStan/StaticRefinerRule.php).
includes:
  - phpstan-rules.php

parameters:
  level: 6
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  # data_surface_react's app installs its Node dependencies beside it.
  excludePaths:
    analyseAndScan:
      - */node_modules/*
      # What the module's own PHPStan rule is tested against: refiners
      # it must flag.
      - tests/fixtures/phpstan/*
  fileExtensions:
    - php
    - module
    - inc
    - install
  # phpstan-drupal's own bootstrap scans every extension in the site and
  # parses every service file it finds, so one unrelated contributed
  # module with a missing class stops the analysis before this module is
  # read at all. The replacement registers the namespaces the analysis
  # actually needs, and tolerates the optional address and tool modules
  # being absent. See phpstan-bootstrap.php.
  bootstrapFiles!:
    - phpstan-bootstrap.php
  ignoreErrors:
    # The broken fixtures exist to be refused when they run; a static
    # refiner that reaches for the container is one of them.
    -
      identifier: dataSurface.staticRefiner
      path: tests/modules/*/src/*/Broken/*
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    # Drupal's plugin factory contract is new static(); the resolvers
    # that take more services than the base class override create() as
    # well as the constructor, so the base call is only ever reached by
    # the resolvers that share its signature.
    -
      identifier: new.static
      path: src/Options/DataSurfaceOptionsResolverBase.php
    # ContainerInjectionInterface::create() is declared to return static,
    # and core's own form base classes are extended freely, so the form a
    # route names stays extensible rather than being sealed to satisfy
    # the rule.
    -
      identifier: new.static
      path: src/Form/DataSurfaceOperationForm.php
    # An assertion that static analysis can prove today is exactly the
    # assertion that has to fail when the code it guards changes, so
    # these stay in the tests rather than being deleted as redundant.
    -
      identifier: staticMethod.alreadyNarrowedType
      path: tests/*
    -
      identifier: method.alreadyNarrowedType
      path: tests/*
