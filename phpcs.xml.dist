<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="surface">
  <description>Drupal and DrupalPractice over this module's own code.</description>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <arg name="extensions" value="php,module,inc,install,info,yml,test,theme"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <file>src</file>
  <file>modules</file>
  <file>tests</file>
  <file>scripts</file>
  <file>surface.api.php</file>
  <file>surface.module</file>
  <file>surface.post_update.php</file>
  <file>surface.info.yml</file>
  <file>surface.services.yml</file>

  <!-- surface_react's app installs its Node dependencies beside it. -->
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <!-- Test modules are never packaged by drupal.org, so the version line
       core's own test modules carry is correct here rather than left out. -->
  <rule ref="Drupal.InfoFiles.AutoAddedKeys.Version">
    <exclude-pattern>tests/modules/*</exclude-pattern>
  </rule>
</ruleset>
