<?php

/**
 * @file
 * Functions for Surface API.
 */

declare(strict_types=1);

/**
 * Creates the config objects a module ships that the site does not have.
 *
 * For a post-update hook: a config object added to a module's
 * config/install after a site installed the module reaches that site
 * this way. An existing object is left as the site has it.
 *
 * @param string $module
 *   The module's machine name.
 *
 * @return string[]
 *   The names of the config objects created.
 *
 * @see \Drupal\surface\Storage\MissingConfigInstaller::install()
 */
function surface_install_missing_config(string $module): array {
  return \Drupal::service('surface.missing_config_installer')->install($module);
}

/**
 * Stores a config object's references to content entities by uuid.
 *
 * For a post-update hook of a module whose resource, stored in a simple
 * config object, held such references as ids before its config storage
 * stored uuids: each id that names an entity is written as that entity's
 * uuid. The values are read and written through the resource's storage,
 * held to its config schema, so the other keys are written as they are.
 * An id that names no entity reads as nothing and is written so.
 *
 * Decision: see docs/decisions.md#a-config-object-stores-a-reference-by-uuid.
 *
 * @param string $resource
 *   The resource, by class or id.
 * @param string $operation
 *   An operation of it that needs no argument, whose context it is read
 *   and written in.
 *
 * @return bool
 *   TRUE when the object changed.
 *
 * @throws \Drupal\surface\Pipeline\StorageViolationsException
 *   When its config schema refuses what is stored.
 */
function surface_store_references_by_uuid(string $resource, string $operation): bool {
  $resources = \Drupal::service('surface.resources');
  $context = $resources->operation($resource, $operation);
  $built = $resources->declaration($resource, $context);
  $storage = $resources->storage($resource, $context, $built);
  // What the storage itself holds, uuids and ids as they are stored.
  $own = $resources->storageInstance($resource);
  $before = $own->load($context);
  $storage->commit($storage->prepare($built, $storage->load($built)));
  return $own->load($context) !== $before;
}
